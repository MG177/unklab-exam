# Next.js frontend — copy to .env.local for local development.
# Do not commit secrets.

# MongoDB (auth + API routes read/write directly — no auth proxy)
MONGO_URI=mongodb://localhost:27017/kep-unklab-exam

# JWT sign/verify for middleware + auth routes
JWT_SECRET=your-jwt-secret-here

# Optional post-cutover (Lane M)
CORS_ORIGINS=
